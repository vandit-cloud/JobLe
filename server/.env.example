# TEMPLATE — copy this file to ".env" and fill in real values.
# This file IS committed to Git so teammates know which variables they need.
# The real .env is gitignored — never commit secrets.

# Port the Node backend listens on.
PORT=5000

# Your MongoDB connection string (free MongoDB Atlas cluster, or local mongodb://...).
# ATLAS GOTCHA: Atlas blocks unknown IPs. On a NEW network (e.g. a hackathon's
# WiFi) your IP changes, so the connection is refused until you re-allowlist it
# in Atlas → Network Access. Before a demo, set the allowlist to 0.0.0.0/0
# (allow from anywhere) so a venue's network can never lock you out.
# (The backend now retries instead of crashing if the DB is unreachable — see
#  config/db.js — but it still can't read/write until the DB is actually reachable.)
MONGO_URI=your-mongodb-connection-string-here

# Any long random string — used to sign login tokens (JWTs). Keep it secret.
JWT_SECRET=change-me-to-a-long-random-string

# URL of the Python resume service. Default works for local dev.
RESUME_SERVICE_URL=http://localhost:8000
