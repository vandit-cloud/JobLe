# TEMPLATE — copy this file to ".env" and fill in real values.
# The real .env is gitignored — never commit secrets.

# Your Groq API key (free at https://console.groq.com).
# With a key set, /parse and /generate-test use Groq's hosted LLM.
# Without one, the service silently falls back to the regex/question-bank baseline.
GROQ_API_KEY=your-groq-api-key-here

# Optional — which Groq model to use. Defaults to llama-3.3-70b-versatile.
# GROQ_MODEL=llama-3.3-70b-versatile

# Optional (lead only) — path to a locally fine-tuned model directory.
# Defaults to ../model-training/trained-model-v6. Teammates can leave this unset.
# LOCAL_MODEL_DIR=

# Optional — set to 1 to log successful Groq parses for later model retraining.
# OFF by default: real resumes contain PII, so only enable with consent/policy.
# CAPTURE_TRAINING_DATA=
